# =============================================================================
# CompliLet Admin Panel — Environment Variables
# File: complilet-admin/.env.example
#
# Copy to .env.local for local development.
# Production values set as Vercel environment variables — NOT committed.
# =============================================================================

# ── Supabase ──────────────────────────────────────────────────────────────────

# Supabase project URL (same project as the agent system)
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE.supabase.co

# Supabase anon key — used by Supabase Auth (browser-safe)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE

# Supabase service-role key — NEVER expose to browser
# Used for all admin data queries (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE

# ── Auth Allowlist ─────────────────────────────────────────────────────────────

# Comma-separated list of emails allowed to log in to the admin panel
# Only these emails can access the dashboard, even if they have Supabase Auth accounts
ADMIN_EMAIL_ALLOWLIST=you@example.com,wife@example.com

# ── Stripe ────────────────────────────────────────────────────────────────────

# Stripe Secret Key — for revenue page queries
STRIPE_SECRET_KEY=sk_live_REPLACE

# ── Site ──────────────────────────────────────────────────────────────────────

# Canonical URL of this admin panel
NEXT_PUBLIC_ADMIN_URL=https://admin.complilet.com

# URL of the main CompliLet dashboard (for deep links in WhatsApp alerts)
NEXT_PUBLIC_DASHBOARD_URL=https://admin.complilet.com
