# =============================================================================
# CompliLet — Supabase Edge Function Secrets
# File: complilet-agents/.env.example
#
# These are NOT .env file values — they are Supabase project secrets.
# Set them with:
#   supabase secrets set KEY=value --project-ref YOUR_PROJECT_REF
#
# Or via the Supabase dashboard:
#   Project → Settings → Edge Functions → Secrets
#
# Local development: create complilet-agents/supabase/.env and paste values.
# This file is committed to git as documentation only — real values are NOT.
# =============================================================================

# ── WhatsApp Business API ─────────────────────────────────────────────────────

# Meta System User access token (never expires if using System User)
# Location: Meta Business Manager → System Users → {user} → Generate Token
# Required permissions: whatsapp_business_messaging, whatsapp_business_management
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxx

# WhatsApp Business Phone Number ID (15-digit number)
# Location: Meta Business Manager → WhatsApp Accounts → {account} → Phone Numbers
PHONE_NUMBER_ID=1234567890123456

# Meta App Secret — used to verify webhook HMAC-SHA256 signatures
# Location: Meta App Dashboard → App Settings → Basic → App Secret
WHATSAPP_APP_SECRET=abcdef1234567890abcdef1234567890

# Meta App verification token — arbitrary string you choose during webhook setup
# Must match exactly what you enter in the Meta webhook configuration
WHATSAPP_VERIFY_TOKEN=complilet-webhook-verify-token-replace

# ── Anthropic / Claude ────────────────────────────────────────────────────────

# Anthropic API key — Claude claude-sonnet-4-6 used for all AI agents
# Location: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE

# ── Stripe ────────────────────────────────────────────────────────────────────

# Stripe Secret Key — server-side only (sk_live_... or sk_test_...)
# Location: dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_test_REPLACE

# Stripe Webhook Signing Secret — verifies webhook event authenticity
# Location: dashboard.stripe.com → Developers → Webhooks → {endpoint} → Signing Secret
# Generate after creating the webhook endpoint pointing to:
#   https://YOUR_PROJECT_REF.supabase.co/functions/v1/stripe-webhook
STRIPE_WEBHOOK_SECRET=whsec_REPLACE

# Stripe Price IDs — created in Stripe Dashboard → Products
# Pay-Per-Screen: £4.99 one-time payment
STRIPE_PRICE_PAY_PER_SCREEN=price_REPLACE

# Landlord Pro: £19.99/month recurring
STRIPE_PRICE_LANDLORD_PRO=price_REPLACE

# Tenancy Manager: £14.99/month metered (usage-based)
STRIPE_PRICE_TENANCY_MANAGER=price_REPLACE

# Portfolio: £39.99/month recurring
STRIPE_PRICE_PORTFOLIO=price_REPLACE

# Global Landlord: £29.99/month metered (usage-based)
STRIPE_PRICE_GLOBAL_LANDLORD=price_REPLACE

# Stripe redirect URLs after checkout (your marketing site pages)
STRIPE_SUCCESS_URL=https://complilet.co.uk/payment/success
STRIPE_CANCEL_URL=https://complilet.co.uk/payment/cancel

# ── Internal Dashboard ────────────────────────────────────────────────────────

# Origin allowed for CORS on the escalation-dashboard Edge Function
# Should match your Vercel deployment URL
DASHBOARD_ORIGIN=https://complilet.co.uk

# ── Escalation Notifications ──────────────────────────────────────────────────

# Phone number to call/WhatsApp for URGENT escalations (safeguarding, crisis)
# Format: E.164 without + prefix (e.g. 447700123456)
ESCALATION_URGENT_PHONE=447700000000

# Phone number for HIGH priority escalations (legal, fraud, complaints)
ESCALATION_HIGH_PHONE=447700000001

# ── Admin Notifications ───────────────────────────────────────────────────────

# Comma-separated E.164 phone numbers (without +) for admin WhatsApp alerts.
# These receive: urgent escalations, payment failures, daily summary, new signups.
# Example: 447700000002,447700000003
ADMIN_PHONES=447700000002

# URL of the admin dashboard — used in WhatsApp alert deep-links
ADMIN_DASHBOARD_URL=https://admin.complilet.co.uk

# ── Supabase (auto-set by Supabase runtime — do not set manually) ─────────────

# These are injected automatically by Supabase Edge Functions runtime.
# Listed here for documentation only.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
